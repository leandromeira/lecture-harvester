# URL base da plataforma de ensino
PLATFORM_URL=https://plataforma.exemplo.com/login

COURSE_NAME=nome_do_curso_aqui
IGNORE_MODULES=modulo_a_ignorar_1,modulo_a_ignorar_2
OBSIDIAN_VAULT_PATH=/caminho/para/seu/vault/Obsidian
AI_MODEL=gpt-4o
AI_TEMPERATURE=0.2
AI_PROVIDER=openai
MAX_LESSONS_PER_RUN=10
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Chaves de API para os provedores de IA
OPENAI_API_KEY=sua-chave-openai-aqui
ANTHROPIC_API_KEY=sua-chave-anthropic-aqui
GEMINI_API_KEY=sua-chave-gemini-aqui
